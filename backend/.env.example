# Database
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<database>

# Auth0
# These two are the only Auth0 vars the backend needs — JWT verification uses Auth0's
# public JWKS (fetched from AUTH0_DOMAIN), so no client secret is required here.
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://your-api-identifier
