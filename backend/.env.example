# Database
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<database>

# Auth0
# These two are the only Auth0 vars the backend needs — JWT verification uses Auth0's
# public JWKS (fetched from AUTH0_DOMAIN), so no client secret is required here.
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://your-api-identifier
# Note: this backend briefly had a POST /api/v1/auth/login endpoint (Resource Owner
# Password Grant) that needed AUTH0_CLIENT_ID/AUTH0_CLIENT_SECRET here. That endpoint was
# removed and login reverted to Auth0's hosted Universal Login (Authorization Code + PKCE,
# handled entirely on the frontend) — these two vars are no longer used by anything and do
# not need to be set.

# CORS
# Comma-separated list of frontend origins allowed to call this API. If unset, defaults to
# local dev only (http://localhost:5173, http://127.0.0.1:5173) — production deployments
# (e.g. Render) must set this explicitly to include the deployed frontend's real URL, or
# the browser will block every request with a CORS error.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://local-management-application.vercel.app
